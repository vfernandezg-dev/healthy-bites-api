# Variables de entorno de Healthy Bites API.
#
# Desarrollo local: copia este archivo como .env (ignorado por git). `./mvnw spring-boot:run` (perfil dev)
# lo carga solo y docker compose también lo lee.
# Producción: define estas variables en el entorno del host; allí no se usa ningún .env.
#
# Formato: CLAVE=valor, una por línea y sin comentarios al final de la línea.

# ===== Obligatorias =====

# Clave para firmar los JWT (HS512): Base64 de al menos 64 bytes, en una sola línea. Genera una con
# (en Windows, openssl escribe CRLF: por eso se borran \r y \n):
#   openssl rand -base64 64 | tr -d '\r\n'
JWT_SECRET=

# Contraseña de la base de datos. En local, docker compose crea la BD con ella
# (solo escucha en 127.0.0.1); si cambias el valor, recrea el volumen con `docker compose down -v`.
DB_PASSWORD=adminadmin

# ===== PayPal (sandbox) =====
# Sin ellas la aplicación arranca, pero el checkout falla.
# Credenciales: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ===== Correo =====
# En local todos los correos van a Mailpit (http://localhost:8025): no hacen falta credenciales.
# En producción: cuenta SMTP, por ejemplo Gmail con una "contraseña de aplicación".
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Buzón que recibe el formulario de contacto de la landing (por defecto, MAIL_USERNAME).
# CONTACT_RECIPIENT=projects@vfernandezg.dev

# ===== Solo producción =====
# Base de datos (en local la conecta docker compose).
# DB_URL=jdbc:postgresql://host:5432/healthybites-db?sslmode=require
# DB_USERNAME=postgres
# URLs públicas (en local valen http://localhost:4210 y http://localhost:8090/api/v1).
# APP_FRONTEND_URL=https://app.example.com
# API_PUBLIC_URL=https://api.example.com/api/v1
# Orígenes permitidos por CORS, separados por comas (en local: el web-app en :4210 y la landing en :4321).
# El web-app accede a toda la API con credenciales; la landing solo a POST /contact.
# CORS_APP_ORIGINS=https://app.example.com
# CORS_LANDING_ORIGINS=https://www.example.com
# Si el proxy delante de la API no tiene IP privada: expresión regular con sus IPs, para que Tomcat
# confíe en su X-Forwarded-For (la IP real del cliente se usa en los límites de peticiones).
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=

# ===== Opcionales =====
# Carpeta de los ficheros subidos (nunca mediafiles/). Por defecto: uploads
# STORAGE_LOCATION=uploads
# Validez del access token, en ISO-8601. Por defecto: PT15M (la sesión se renueva con el refresh token).
# JWT_ACCESS_TOKEN_TTL=PT15M
# Muestra el SQL de Hibernate en el log.
# SHOW_SQL=true
